{
    "name": "usamamuneerchaudhary/gatekeeper-audit",
    "description": "Audit Laravel routes for missing object-level authorization (BOLA / IDOR) and unscoped model lookups.",
    "keywords": ["laravel", "security", "bola", "idor", "authorization", "audit", "owasp"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/usamamuneerchaudhary/gatekeeper-audit",
    "support": {
        "issues": "https://github.com/usamamuneerchaudhary/gatekeeper-audit/issues",
        "source": "https://github.com/usamamuneerchaudhary/gatekeeper-audit",
        "security": "https://github.com/usamamuneerchaudhary/gatekeeper-audit/security/advisories/new"
    },
    "authors": [
        {
            "name": "Usama Muneer Chaudhary",
            "homepage": "https://github.com/usamamuneerchaudhary"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0|^12.0|^13.0",
        "usamamuneerchaudhary/laravel-slipway": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Usamamuneerchaudhary\\GatekeeperAudit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Usamamuneerchaudhary\\GatekeeperAudit\\Tests\\Fixtures\\": "support/Fixtures/",
            "Usamamuneerchaudhary\\GatekeeperAudit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Usamamuneerchaudhary\\GatekeeperAudit\\GatekeeperServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "slipway:compile": "vendor/bin/testbench slipway:compile",
        "slipway:check": "vendor/bin/testbench slipway:check"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
